# ══════════════════════════════════════════════════════════════════════
# Etson Sales Agent — Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3001

# ── Sarvam AI (Voice Calls + Analytics) ──────────────────────────────
# Get from: https://indus.sarvam.ai → your agent
SARVAM_API_KEY=
SARVAM_AGENT_ID=

# Get from your agent URL:
# https://indus.sarvam.ai/org/{ORG_ID}/workspace/{WORKSPACE_ID}/apps/{APP_ID}
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=

# ── Whatomate (WhatsApp Gateway) ──────────────────────────────────────
# Setup: docker run -d -p 8080:8080 ghcr.io/shridarpatil/whatomate:latest
# Then: open http://localhost:8080 → scan QR → Settings → API Keys → Create
WHATOMATE_URL=http://localhost:8080
WHATOMATE_API_KEY=

# ── Sales Team Contact ────────────────────────────────────────────────
# WhatsApp number for hot lead alerts (country code + number, no + or spaces)
SALES_TEAM_WHATSAPP=91XXXXXXXXXX
SALES_TEAM_EMAIL=

# ── OpenAI (Optional — for AI follow-up messages) ─────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email Alerts (Optional — Gmail SMTP) ─────────────────────────────
# Enable 2FA on Gmail → myaccount.google.com/apppasswords → create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── App URL (for links in WhatsApp messages) ──────────────────────────
APP_URL=http://localhost:5173
